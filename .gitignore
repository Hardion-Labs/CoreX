.zig-cache/
zig-out/
.zig-cache-*

# Asset import cache (derived data, reproducible from sources)
.corex-cache/

# Compiled objects, libraries, and executables
*.o
*.obj
# ...but a Wavefront OBJ is *source* geometry the asset loader decodes, not a
# compiled object, and example projects ship it as text.
!examples/**/assets/*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe

# Debug and profiling output
*.pdb
*.dSYM/
*.prof
*.profraw
*.profdata
*.trace
*.gcda
*.gcno

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo

# Python bytecode from the test-vector generators
__pycache__/
*.pyc

# Local environment and temporary files
.env
.env.*
!.env.example
*.tmp
*.bak
