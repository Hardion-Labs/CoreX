root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{zig,c,h,cc,cpp,hpp}]
indent_style = space
indent_size = 4

[{*.yml,*.yaml,*.json,*.toml}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
max_line_length = off